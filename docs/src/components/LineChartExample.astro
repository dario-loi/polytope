---
// A small line chart drawn at build time from synthetic data, with direct labels,
// a legend, a hover crosshair, and a data table. Shows the chart rules in practice.
import Chart from "@dario-loi/polytope/astro/Chart.astro";
const epochs = Array.from({ length: 11 }, (_, i) => i * 10);
const curve = (a: number, k: number, c: number) => epochs.map((e) => +(c - a * Math.exp(-k * e)).toFixed(3));
const series = [
  { name: "Model A", values: curve(0.42, 0.045, 0.86) },
  { name: "Model B", values: curve(0.45, 0.03, 0.81) },
  { name: "Model C", values: curve(0.4, 0.06, 0.74) },
];
const W = 640, H = 300, m = { t: 12, r: 92, b: 34, l: 44 };
const x = (e: number) => m.l + (e / 100) * (W - m.l - m.r);
const y = (v: number) => m.t + (1 - (v - 0.3) / 0.6) * (H - m.t - m.b);
const ticksY = [0.3, 0.45, 0.6, 0.75, 0.9];
const path = (vals: number[]) => vals.map((v, i) => `${i ? "L" : "M"}${x(epochs[i]).toFixed(1)},${y(v).toFixed(1)}`).join("");
// direct labels: nudge apart if closer than 14px
const ends = series.map((s, i) => ({ i, y: y(s.values.at(-1)!) })).sort((a, b) => a.y - b.y);
for (let k = 1; k < ends.length; k++) if (ends[k].y - ends[k - 1].y < 14) ends[k].y = ends[k - 1].y + 14;
const labelY = Object.fromEntries(ends.map((e) => [e.i, e.y]));
---
<Chart title="Validation accuracy by epoch" subtitle="Synthetic example data" legend={series.map((s) => ({ label: s.name, shape: "line" }))}>
  <svg viewBox={`0 0 ${W} ${H}`} width="100%" role="img" aria-label="Line chart of synthetic validation accuracy for three models over 100 epochs. Model A ends highest at 0.86." data-ply-linechart data-series={JSON.stringify(series)} data-epochs={JSON.stringify(epochs)}>
    <g class="grid">{ticksY.map((v) => <line x1={m.l} x2={W - m.r} y1={y(v)} y2={y(v)} />)}</g>
    <g class="axis">
      {ticksY.map((v) => <text x={m.l - 8} y={y(v) + 4} text-anchor="end">{v.toFixed(2)}</text>)}
      {epochs.filter((e) => e % 20 === 0).map((e) => <text x={x(e)} y={H - 12} text-anchor="middle">{e}</text>)}
    </g>
    <line class="ply-baseline" x1={m.l} x2={W - m.r} y1={H - m.b} y2={H - m.b} />
    {series.map((s, i) => <path d={path(s.values)} fill="none" stroke={`var(--ply-viz-${i + 1})`} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />)}
    {series.map((s, i) => <text class="ply-direct-label" x={W - m.r + 8} y={labelY[i] + 4}>{s.name}</text>)}
    <g class="xh" style="display:none"><line class="xh__line" y1={m.t} y2={H - m.b} />{series.map((_, i) => <circle r="4.5" fill={`var(--ply-viz-${i + 1})`} stroke="var(--ply-viz-surface)" stroke-width="2" />)}</g>
    <rect class="xh__hit" x={m.l} y={m.t} width={W - m.l - m.r} height={H - m.t - m.b} fill="transparent" />
  </svg>
  <div class="ply-tooltip" hidden></div>
  <div class="ply-table-wrap" slot="table">
    <table class="ply-table">
      <thead><tr><th>Epoch</th>{series.map((s) => <th class="ply-num">{s.name}</th>)}</tr></thead>
      <tbody>{epochs.map((e, i) => <tr><td>{e}</td>{series.map((s) => <td class="ply-num">{s.values[i].toFixed(3)}</td>)}</tr>)}</tbody>
    </table>
  </div>
</Chart>
<style is:global>
  .xh__line { stroke: var(--ply-color-text-muted); stroke-width: 1; stroke-dasharray: 3 3; }
</style>
<script>
  for (const svg of document.querySelectorAll<SVGSVGElement>("[data-ply-linechart]")) {
    const series = JSON.parse(svg.dataset.series!);
    const epochs: number[] = JSON.parse(svg.dataset.epochs!);
    const plot = svg.closest(".ply-chart__plot") as HTMLElement;
    const tip = plot.querySelector(".ply-tooltip") as HTMLElement;
    const xh = svg.querySelector(".xh") as SVGGElement;
    const hit = svg.querySelector(".xh__hit") as SVGRectElement;
    const line = xh.querySelector("line")!;
    const dots = [...xh.querySelectorAll("circle")];
    const paths = [...svg.querySelectorAll("path")];
    const move = (ev: PointerEvent) => {
      const pt = new DOMPoint(ev.clientX, ev.clientY).matrixTransform(svg.getScreenCTM()!.inverse());
      const x0 = +hit.getAttribute("x")!, w = +hit.getAttribute("width")!;
      const i = Math.max(0, Math.min(epochs.length - 1, Math.round(((pt.x - x0) / w) * (epochs.length - 1))));
      const px = x0 + (i / (epochs.length - 1)) * w;
      line.setAttribute("x1", String(px)); line.setAttribute("x2", String(px));
      dots.forEach((d, k) => {
        const seg = paths[k].getAttribute("d")!.split(/[ML]/).filter(Boolean)[i].split(",");
        d.setAttribute("cx", seg[0]); d.setAttribute("cy", seg[1]);
      });
      xh.style.display = "";
      tip.hidden = false;
      tip.innerHTML = `<b>Epoch ${epochs[i]}</b><br>` + series.map((s: any) => `${s.name}: ${s.values[i].toFixed(3)}`).join("<br>");
      const r = plot.getBoundingClientRect();
      const left = ev.clientX - r.left + 14;
      tip.style.left = `${Math.min(left, r.width - tip.offsetWidth - 4)}px`;
      tip.style.top = `${ev.clientY - r.top - 10}px`;
    };
    hit.addEventListener("pointermove", move);
    hit.addEventListener("pointerleave", () => { xh.style.display = "none"; tip.hidden = true; });
  }
</script>
