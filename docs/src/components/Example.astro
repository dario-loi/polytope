---
// A live example and the markup that produced it, from one string. It runs to the main
// column's edge, wider than the reading column, so the class names at the ends of the
// markup's lines stay in view.
import Code from "@dario-loi/polytope/astro/Code.astro";
interface Props { html: string; title?: string; panel?: boolean; lang?: string; code?: string; pad?: boolean }
const { html, title = "HTML", panel = false, lang = "html", code, pad = true } = Astro.props;
---
<div class="ex ply-wide">
  <div class:list={["ex__live", panel && "ply-panel", !pad && "ex__live--flush"]} data-surface={panel ? "panel" : undefined} set:html={html} />
  <Code code={code ?? html} lang={lang} title={title} class="ex__code" />
</div>
<style is:global>
  .ex { margin-block: var(--ply-space-5); max-width: none; }
  /* Live specimens stop looping after a few passes (WCAG 2.2.2). */
  .ex__live { --ply-loading-count: 4; }
  .ex__live { padding: var(--ply-space-5); border: var(--ply-border-control) solid var(--ply-color-rule-strong); border-bottom: 0; }
  .ex__live--flush { padding: 0; }
  .ex__live.ply-panel { border-color: var(--ply-color-panel); }
  .ex .ex__code { max-width: none; }
</style>
