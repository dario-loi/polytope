---
import "@dario-loi/polytope/css";
import "katex/dist/katex.min.css";
import TopBar from "@dario-loi/polytope/astro/TopBar.astro";
import ThemeToggle from "@dario-loi/polytope/astro/ThemeToggle.astro";
import Icon from "@dario-loi/polytope/astro/Icon.astro";
import Search from "@dario-loi/polytope/astro/Search.astro";
import { base, chapters, locate, u } from "../data/nav";
import { version } from "../data/version";

interface Props { title: string; description?: string; chrome?: boolean }
const { title, description = "Polytope: tokens, CSS components, and Astro components for academic sites, paper pages, and research demos.", chrome = true } = Astro.props;
const here = locate(Astro.url.pathname);
const links = chapters.map((c) => ({ label: c.label, href: u(c.path), current: c === here.chapter }));
const pageTitle = title === "Polytope" ? title : `${title} - Polytope`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <meta name="theme-color" content="#141414" />
    <script is:inline>try{var t=localStorage.getItem("ply-theme");if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
  </head>
  <body>
    <a class="ply-skip" href="#main">Skip to content</a>
    {chrome && (
      <TopBar brand="Polytope" brandHref={u("/")} links={links}>
        <Search
          href={u("/tokens/#tk-q")}
          bundle={u("/pagefind/")}
          baseUrl={`${base}/`}
          placeholder="Search pages, tokens, and classes"
          hint="Finds pages and their sections, every token, every .ply class, and every Astro component."
          links={chapters.map((c) => ({ label: c.label, href: u(c.path) }))}
          ranking={{ pageLength: 0.2 }}
        />
        <a class="ply-button ply-button--ghost ply-button--icon ply-button--sm ply-hide-narrow" href="https://github.com/dario-loi/polytope" aria-label="Source on GitHub"><Icon name="code" /></a>
        <ThemeToggle />
      </TopBar>
    )}
    <slot />
    {chrome && (
      <footer class="ply-site-footer">
        <div class="ply-container ply-site-footer__inner">
          <p><span class="ply-display">Polytope</span> version {version}. Made by Dario Loi, Northeastern University.</p>
          <p class="ply-muted ply-small">Static site, hosted for free. Type: Ultra, Libre Franklin, JetBrains Mono. <a href="https://github.com/dario-loi/polytope">Source</a> under Apache 2.0.</p>
        </div>
      </footer>
    )}
  </body>
</html>
<script>import "@dario-loi/polytope/js/all.js";</script>
<style is:global>
  .ply-site-footer { border-top: var(--ply-border-rule) solid var(--ply-color-rule-strong); margin-top: var(--ply-space-7); }
  .ply-site-footer__inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--ply-space-3) var(--ply-space-6); padding-block: var(--ply-space-6) var(--ply-space-7); }
  .ply-site-footer .ply-display { font-size: var(--ply-size-xl); }
</style>
