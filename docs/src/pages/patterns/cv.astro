---
import Pattern from "../../layouts/Pattern.astro";
import Atlas from "@dario-loi/polytope/astro/Atlas.astro";
import AtlasStop from "@dario-loi/polytope/astro/AtlasStop.astro";
import MastTitle from "@dario-loi/polytope/astro/MastTitle.astro";
import Button from "@dario-loi/polytope/astro/Button.astro";
import Icon from "@dario-loi/polytope/astro/Icon.astro";
import { stops } from "../../data/atlas-example";
---
<Pattern title="CV page" current="CV" description="An example CV page built with Polytope: entries for study and work beside a globe that turns to each place as you read.">
  <div class="ply-container cv-atlas">
    <Atlas label="Where John Doe has studied and worked">
      <Fragment slot="head">
        <MastTitle title="Curriculum vitae" />
        <p class="ply-mast__lede">John Doe, PhD student at Example University. Where I have studied and worked, newest first; the globe follows as you read.</p>
        <div class="ply-cluster" style="margin-top: var(--ply-space-5)">
          <Button href="#"><Icon name="download" />Full CV as PDF</Button>
          <Button href="#" variant="ghost"><Icon name="mail" />Email</Button>
        </div>
      </Fragment>
      {stops.map((s) => (
        <AtlasStop level={2} title={s.title} org={s.org} kind={s.kind} place={s.place} lat={s.lat} lon={s.lon} from={s.from} to={s.to}>
          <p>{s.text}</p>
        </AtlasStop>
      ))}
    </Atlas>
  </div>
</Pattern>
<style>
  .cv-atlas { padding-block-start: var(--ply-space-6); }
</style>
