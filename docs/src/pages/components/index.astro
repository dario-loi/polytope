---
import Docs from "../../layouts/Docs.astro";
import ComponentModel from "../../components/exhibits/ComponentModel.astro";
import Stability from "@dario-loi/polytope/astro/Stability.astro";
import { u } from "../../data/nav";
const families = [
  ["Buttons and tags", "/components/buttons/", "Buttons, tags, status labels, stability labels.", "stable"],
  ["Navigation", "/components/navigation/", "Top bar, chapter tabs, sidebar, on-this-page list, breadcrumb, pager.", "stable"],
  ["Notes", "/components/notes/", "Note, info, warning, success, and danger callouts.", "stable"],
  ["Forms", "/components/forms/", "Inputs, selects, checkboxes, radios, switches, sliders, segmented controls.", "stable"],
  ["Tables", "/components/tables/", "Data tables with tabular numbers, stripes, and captions.", "stable"],
  ["Code", "/components/code/", "Highlighted code panels with copy, inline code, keyboard keys.", "stable"],
  ["Probability machine", "/components/machine/", "The live Galton board and the loading indicator.", "experimental"],
  ["Research", "/components/research/", "Paper header, figures, equations, citations, BibTeX, publication wall.", "experimental"],
  ["Long-form writing", "/components/writing/", "Sidenotes, footnotes, theorem environments, collapsible sections.", "experimental"],
  ["Demo chrome", "/components/demo/", "App shell, controls, readouts, empty states, toasts.", "experimental"],
  ["Charts", "/components/charts/", "Chart frame, legend, tooltip, texture fill.", "experimental"],
] as const;
---
<Docs title="Components" lede="Every part of the kit, as plain HTML classes and as Astro components.">
  <ComponentModel slot="exhibit" />
  <p>Each component page shows a live example, the HTML that made it, the Astro way to write it, and what can be changed. The HTML version works anywhere; the Astro version prints the same markup.</p>
  <div class="ply-table-wrap">
    <table class="ply-table">
      <thead><tr><th>Family</th><th>What is in it</th><th>Status</th></tr></thead>
      <tbody>{families.map(([name, path, what, level]) => <tr><td><a href={u(path)}>{name}</a></td><td>{what}</td><td><Stability level={level} /></td></tr>)}</tbody>
    </table>
  </div>
  <p>Everything is version 0.1. "Stable" means the class names and props are not expected to change before 1.0; "experimental" means they might.</p>
</Docs>
