---
// Theorem-like environments: definition, theorem, lemma, proposition, corollary, remark, example, proof.
interface Props {
  kind: "definition" | "theorem" | "lemma" | "proposition" | "corollary" | "remark" | "example" | "proof";
  num?: number | string;
  name?: string;
  id?: string;
}
const { kind, num, name, id } = Astro.props;
const word = kind[0].toUpperCase() + kind.slice(1);
---
<div class:list={["ply-env", `ply-env--${kind}`]} id={id} role="group" aria-label={`${word}${num ? " " + num : ""}`}>
  <span class="ply-env__head">{word}{num !== undefined && ` ${num}`}{name && <span class="ply-env__name"> ({name})</span>}.</span>
  <slot />
</div>
