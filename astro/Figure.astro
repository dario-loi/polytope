---
// margin puts a small figure in the margin after the text, beside the paragraph after it,
// and keeps it in the text on narrow screens. wide runs a figure on past the text on a docs
// page; an article keeps it to the text, since its margin belongs to the notes.
// column keeps a figure to the text's width wherever it sits, as a key figure in a paper's
// header keeps to the text while the header's other figures run wider. split sets a long
// caption under a wide figure in two balanced columns from 60rem, which keeps its lines near
// the reading measure and its edges the figure's.
interface Props { num?: number | string; id?: string; wide?: boolean; margin?: boolean; column?: boolean; split?: boolean; class?: string }
const { num, id, wide = false, margin = false, column = false, split = false, class: className } = Astro.props;
---
<figure class:list={["ply-figure", wide && "ply-figure--wide ply-wide", margin && "ply-margin", column && "ply-figure--column", split && "ply-figure--split", className]} id={id}>
  <slot />
  {Astro.slots.has("caption") && (
    <figcaption>{num !== undefined && <span class="ply-figure__num">Figure {num}.</span>}<slot name="caption" /></figcaption>
  )}
</figure>
