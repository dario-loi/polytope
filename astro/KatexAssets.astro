---
// KaTeX's stylesheet and fonts for a page with math, written for the head: the stylesheet inline,
// so the first paint does not wait for a request (a linked stylesheet blocks it), and the five
// faces a formula uses preloaded, since left to the stylesheet they are found only after the
// first layout. <M> and <Equation> import the stylesheet themselves, as a link, which suits a
// page with a little math; a page that cares about its first paint puts this in <head> instead,
// when `hasMath` says its text has some, and shows math with <Tex>.
//   {hasMath(paper.tldr, paper.abstract) && <KatexAssets />}
// Needs `katex` installed (Polytope depends on it) and a bundler that reads Vite's ?inline and
// ?url suffixes, as Astro's does.
import css from "katex/dist/katex.min.css?inline";
import main from "katex/dist/fonts/KaTeX_Main-Regular.woff2?url";
import mainBold from "katex/dist/fonts/KaTeX_Main-Bold.woff2?url";
import mathItalic from "katex/dist/fonts/KaTeX_Math-Italic.woff2?url";
import ams from "katex/dist/fonts/KaTeX_AMS-Regular.woff2?url";
import caligraphic from "katex/dist/fonts/KaTeX_Caligraphic-Regular.woff2?url";
interface Props {
  /** false skips the font preloads, for a page where the math is far down. */
  preload?: boolean;
}
const { preload = true } = Astro.props;
const fonts = [main, mathItalic, ams, mainBold, caligraphic];
---
<style set:html={css} />
{preload && fonts.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
