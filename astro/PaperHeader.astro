---
// Header for a paper page: venue, title, authors with affiliation marks, link row.
import Icon from "./Icon.astro";
import WoodTitle from "./WoodTitle.astro";
import { keptWhenFolded } from "./authors.ts";
export interface Author { name: string; href?: string; affiliations?: number[]; equal?: boolean }
interface Props {
  title: string;
  venue?: string;
  authors: Author[];
  affiliations?: string[];
  /** The first link is the primary button, unless another has `primary`. */
  links?: { label: string; href: string; icon?: "paper" | "code" | "data" | "quote" | "external" | "download"; primary?: boolean }[];
  equalNote?: string;
  /** Heading level of the title: 1 on a paper page, 2 when the header sits inside another page. */
  level?: 1 | 2 | 3 | 4;
  /** The author name to set in bold, as in PubList; the other names drop to regular. */
  me?: string;
  /** A title with a subtitle ("Name: what it does") sets the name in wood type and the
   *  subtitle under it in the text face. false keeps the whole title in wood type. */
  split?: boolean;
  /** Past this many authors the list folds to the first names, yours, and the last, with a
   *  button for the whole list. The fold is in the page as built, so nothing moves when it
   *  loads; without script, and on paper, the list shows whole. */
  fold?: number;
  /** The fold button's words, for another language; {n} is the number of authors. */
  foldText?: { more: string; less: string };
}
const { title, venue, authors, affiliations = [], links = [], equalNote = "Equal contribution", level = 1, me, split = true, fold, foldText = { more: "Show all {n} authors", less: "Show fewer authors" } } = Astro.props;
const more = foldText.more.replace("{n}", String(authors.length));
const anyEqual = authors.some((a) => a.equal);
const primary = Math.max(0, links.findIndex((l) => l.primary));
const folds = fold !== undefined && fold > 0 && authors.length > fold;
const kept = folds ? keptWhenFolded(authors.length, authors.findIndex((a) => a.name === me), fold) : () => true;
---
<header class="ply-paper">
  <WoodTitle class="ply-paper__title" level={level} title={title} split={split} />
  <div class="ply-stack" style="--ply-stack-gap: var(--ply-space-2)">
    <ul class="ply-authors" aria-label="Authors" data-folded={folds ? "" : undefined}>
      {authors.map((a, i) => {
        const marks = [...(a.affiliations ?? []).map(String), ...(a.equal ? ["*"] : [])].join(",");
        return <>
          {!kept(i) && kept(i - 1) && <li class="ply-authors__gap" aria-hidden="true">...</li>}
          <li class:list={[me && a.name === me && "ply-me", !kept(i) && "ply-authors__more"]}>{a.href ? <a href={a.href}>{a.name}</a> : a.name}{marks && <sup>{marks}</sup>}</li>
        </>;
      })}
      {folds && <li class="ply-authors__toggle"><button type="button" aria-expanded="false" data-ply-fold data-more={more} data-less={foldText.less}>{more}</button></li>}
    </ul>
    {affiliations.length > 0 && (
      <ul class="ply-affiliations" aria-label="Affiliations">
        {affiliations.map((aff, i) => <li><sup>{i + 1}</sup> {aff}</li>)}
      </ul>
    )}
    {anyEqual && <p class="ply-authors__note"><sup>*</sup> {equalNote}</p>}
    {venue && <p class="ply-paper__venue">{venue}</p>}
  </div>
  {links.length > 0 && (
    <div class="ply-paper__links">
      {links.map((l, i) => (
        <a class:list={["ply-button ply-button--sm", i !== primary && "ply-button--secondary"]} href={l.href}>{l.icon && <Icon name={l.icon} />}{l.label}</a>
      ))}
    </div>
  )}
</header>
<script>import "../dist/js/fold.js";</script>
