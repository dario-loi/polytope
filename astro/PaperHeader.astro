---
// Header for a paper page: venue, title, authors with affiliation marks, link row.
import Icon from "./Icon.astro";
import { woodTitle } from "./title.ts";
export interface Author { name: string; href?: string; affiliations?: number[]; equal?: boolean }
interface Props {
  title: string;
  venue?: string;
  authors: Author[];
  affiliations?: string[];
  links?: { label: string; href: string; icon?: "paper" | "code" | "data" | "quote" | "external" | "download" }[];
  equalNote?: string;
  /** Heading level of the title: 1 on a paper page, 2 when the header sits inside another page. */
  level?: 1 | 2 | 3;
  /** The author name to set in bold, as in PubList; the other names drop to regular. */
  me?: string;
  /** A title with a subtitle ("Name: what it does") sets the name in wood type and the
   *  subtitle under it in the text face. false keeps the whole title in wood type. */
  split?: boolean;
}
const { title, venue, authors, affiliations = [], links = [], equalNote = "Equal contribution", level = 1, me, split = true } = Astro.props;
const H = `h${level}`;
const anyEqual = authors.some((a) => a.equal);
// The colon stays in the heading's text, hidden, so it is still read out and copied.
const cut = split ? title.indexOf(": ") : -1;
const hasSub = cut > 0 && cut + 2 < title.length;
const name = woodTitle(hasSub ? title.slice(0, cut) : title);
---
<header class="ply-paper">
  <H class="ply-paper__title" style={`--_len: ${name.len}; --_chars: ${name.chars}`}>{name.parts.map((p) => (p.keep ? <span class="ply-nowrap">{p.text}</span> : p.text))}{hasSub && <><span class="ply-visually-hidden">: </span><span class="ply-paper__subtitle">{title.slice(cut + 2)}</span></>}</H>
  <div class="ply-stack" style="--ply-stack-gap: var(--ply-space-2)">
    <ul class="ply-authors" aria-label="Authors">
      {authors.map((a) => {
        const marks = [...(a.affiliations ?? []).map(String), ...(a.equal ? ["*"] : [])].join(",");
        return <li class={me && a.name === me ? "ply-me" : undefined}>{a.href ? <a href={a.href}>{a.name}</a> : a.name}{marks && <sup>{marks}</sup>}</li>;
      })}
    </ul>
    {affiliations.length > 0 && (
      <ul class="ply-affiliations" aria-label="Affiliations">
        {affiliations.map((aff, i) => <li><sup>{i + 1}</sup> {aff}</li>)}
      </ul>
    )}
    {anyEqual && <p class="ply-authors__note"><sup>*</sup> {equalNote}</p>}
    {venue && <p class="ply-paper__venue">{venue}</p>}
  </div>
  {links.length > 0 && (
    <div class="ply-paper__links">
      {links.map((l, i) => (
        <a class:list={["ply-button ply-button--sm", i > 0 && "ply-button--secondary"]} href={l.href}>{l.icon && <Icon name={l.icon} />}{l.label}</a>
      ))}
    </div>
  )}
</header>
