---
// Page mast: the title (with the tomato full stop), a lede, and an exhibit slot on the right.
// Without an exhibit the mast stays one column. `compact` sets a smaller title, for a list
// page under the chapter landings.
import MastTitle from "./MastTitle.astro";
interface Props { title: string; lede?: string; stop?: boolean; compact?: boolean; class?: string }
const { title, lede, stop = true, compact = false, class: className } = Astro.props;
// A slot passed on from a layout counts as filled even when it is empty, so look at what it
// holds.
const exhibit = Astro.slots.has("exhibit") ? (await Astro.slots.render("exhibit")).trim() : "";
---
<header class:list={["ply-container ply-mast", compact && "ply-mast--compact", className]}>
  <div>
    <MastTitle title={title} stop={stop} />
    {lede && <p class="ply-mast__lede">{lede}</p>}
    <slot name="after" />
  </div>
  {exhibit && <div class="ply-mast__exhibit"><Fragment set:html={exhibit} /></div>}
</header>
