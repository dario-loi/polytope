---
// Demo and tool chrome. Slots: head (right side of the header), controls, default (the stage), status.
interface Props { title: string; level?: 2 | 3 | 4; class?: string }
const { title, level = 2, class: className } = Astro.props;
const H = `h${level}`;
---
<section class:list={["ply-app", className]} aria-label={title}>
  <header class="ply-app__head">
    <H class="ply-app__title">{title}</H>
    <div class="ply-cluster"><slot name="head" /></div>
  </header>
  <div class="ply-app__controls"><slot name="controls" /></div>
  <div class="ply-app__stage ply-panel--flush" data-surface="panel"><slot /></div>
  <footer class="ply-app__status" aria-live="polite"><slot name="status" /></footer>
</section>
