---
// A Vietoris-Rips complex with a radius slider. Server-renders the same complex from the
// seed so it is complete without JavaScript; complex.js makes the slider live.
// autoplay="visible" grows it from bare points on first view; the default draws it finished.
// With autoplay the server's edges and triangles stay hidden while the script loads (machine.css),
// and the slider and counts start at 0 to match; without script they do nothing, so they hide.
interface Props { points?: number; radius?: number; seed?: number; label?: string; controls?: boolean; autoplay?: "visible" | "none"; id?: string; class?: string }
const { points = 36, radius = 0.16, seed = 7, label = "A random complex", controls = true, autoplay = "none", id = `cx-${seed}-${points}`, class: className } = Astro.props;

// same generator, layout, and dense-drawing budget as css/js/complex.js
const DENSE = 2000;
let s = seed >>> 0 || 1;
const rand = () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296);
const cols = Math.ceil(Math.sqrt(points * 1.8)), rows = Math.ceil(points / cols);
const pts = Array.from({ length: points }, (_, i) => {
  const c = i % cols, r = Math.floor(i / cols);
  return [6 + ((c + 0.15 + rand() * 0.7) / cols) * 88, 5 + ((r + 0.15 + rand() * 0.7) / rows) * 46];
});
const R = radius * 100;
const adj = pts.map(() => new Set<number>());
const edges: [number, number][] = [];
for (let i = 0; i < points; i++) for (let j = i + 1; j < points; j++) {
  if (Math.hypot(pts[i][0] - pts[j][0], pts[i][1] - pts[j][1]) <= R) { edges.push([i, j]); adj[i].add(j); adj[j].add(i); }
}
const tris: [number, number, number][] = [];
for (const [i, j] of edges) for (const k of adj[i]) if (k > j && adj[j].has(k)) tris.push([i, j, k]);
const grows = autoplay === "visible";
const shown = grows ? { radius: 0, edges: 0, triangles: 0 } : { radius, edges: edges.length, triangles: tris.length };
---
<div class:list={["ply-complex-wrap", className]}>
  <ply-complex class="ply-complex" id={id} points={points} radius={radius} seed={seed} label={label} autoplay={autoplay} role="img" aria-label={`${label}: ${points} points, ${edges.length} edges, ${tris.length} filled triangles.`}>
    <svg class="ply-complex__static" viewBox="0 0 100 56" aria-hidden="true">
      <g>{tris.length > DENSE
        ? <path class="ply-complex__tri ply-complex__tri--dense" d={tris.map(([a, b, c]) => `M${pts[a]}L${pts[b]}L${pts[c]}Z`).join("")} />
        : tris.map(([a, b, c]) => <polygon class="ply-complex__tri" points={`${pts[a]} ${pts[b]} ${pts[c]}`} />)}</g>
      <g>{edges.length > DENSE
        ? <path class="ply-complex__edge" d={edges.map(([a, b]) => `M${pts[a]}L${pts[b]}`).join("")} />
        : edges.map(([a, b]) => <line class="ply-complex__edge" x1={pts[a][0]} y1={pts[a][1]} x2={pts[b][0]} y2={pts[b][1]} />)}</g>
      <g>{pts.map(([x, y]) => <circle class="ply-complex__pt" cx={x} cy={y} r="0.9" />)}</g>
    </svg>
  </ply-complex>
  {controls && (
    <div class="ply-complex-controls" data-grows={grows ? "" : undefined}>
      <div class="ply-control" data-ply-slider data-format="fixed2">
        <label class="ply-control__label" for={`${id}-r`}>Radius</label>
        <div class="ply-range">
          <input class="ply-slider" type="range" id={`${id}-r`} min="0" max="0.32" step="0.01" value={shown.radius} data-ply-complex-radius for={id} />
          <output for={`${id}-r`}>{shown.radius.toFixed(2)}</output>
        </div>
      </div>
      <p class="ply-complex-counts">
        <span><b data-count="edges">{shown.edges}</b> edges</span>
        <span><b data-count="triangles">{shown.triangles}</b> triangles</span>
      </p>
    </div>
  )}
</div>
<script>
  import "../dist/js/complex.js";
  import "../dist/js/controls.js";
  document.addEventListener("ply-complex-change", (e: Event) => {
    const el = e.target as HTMLElement;
    const wrap = el.closest(".ply-complex-wrap");
    const d = (e as CustomEvent).detail;
    // Written only when a count changes: most frames of the growth leave them as they were.
    wrap?.querySelectorAll<HTMLElement>("[data-count]").forEach((b) => { const v = String(d[b.dataset.count!]); if (b.textContent !== v) b.textContent = v; });
    // The slider reads out the counts with its value, once per step, instead of a live region
    // that queues an announcement for every step. rAF: after controls.js sets the plain value.
    const input = wrap?.querySelector<HTMLInputElement>("[data-ply-complex-radius]");
    if (input) requestAnimationFrame(() => {
      const text = `${d.radius.toFixed(2)}: ${d.edges} edges, ${d.triangles} triangles`;
      if (input.getAttribute("aria-valuetext") !== text) input.setAttribute("aria-valuetext", text);
    });
  });
</script>
