---
// Head tags that tell search engines and link previews what a page is: the title, the
// description, the canonical address, Open Graph and Twitter cards, and structured data.
// Put it inside <head>, in place of your own <title>. Set `site` in astro.config so every
// address comes out absolute; without it, the canonical link and og:url are left out.
//   <Seo title="John Doe" description="PhD student at Example University." image={og} person={{ name: "John Doe" }} />
// A paper page passes `citation`: the citation_ tags Google Scholar indexes papers by, and
// a ScholarlyArticle record. Pass the same authors array PaperHeader takes. The record's @id
// is the canonical address with #article, so a fuller record of the same paper that a site
// writes itself, with the same @id, merges with it instead of counting as a second work.
// Records that share an @id are written as one, with the fields given in `schema` winning.
// A citation's authors may carry their institutions, and its keywords, arXiv number, and
// abstract page go into the citation_ tags too, which Scholar and reference managers read.
// The twitter tags mirror the Open Graph ones, the image's type and a large-preview hint for
// search are written, and `icons` links the favicon set. The browser's address bar takes the
// page's ground: two theme-color metas scoped to the system theme, which js/theme.js rewrites
// once a visitor picks a theme with the switch.

/** A paper, for Google Scholar and reference managers. */
export interface Citation {
  title: string;
  authors: (string | { name: string; href?: string; institutions?: string[] })[];
  /** "2026", "2026-06", or "2026-06-14". */
  date: string | Date;
  journal?: string;
  conference?: string;
  volume?: string | number;
  issue?: string | number;
  firstPage?: string | number;
  lastPage?: string | number;
  /** The PDF, absolute or relative to the page. Scholar prefers one on the same site. */
  pdf?: string;
  doi?: string;
  /** The arXiv identifier: the part of the address after arxiv.org/abs/. */
  arxiv?: string;
  abstract?: string;
  /** Subjects, written as citation_keywords. */
  keywords?: string[];
  /** The ScholarlyArticle record's @id. Defaults to the canonical address with #article;
   *  left out without one, as on a noindex page, unless given here. */
  id?: string;
}

/** The person a homepage or CV is about. */
export interface Person {
  name: string;
  /** Their homepage. Defaults to this page. */
  url?: string;
  jobTitle?: string;
  affiliation?: string;
  /** Profiles elsewhere: ORCID, Google Scholar, GitHub, a university page. */
  sameAs?: string[];
  image?: string;
  /** The Person record's @id. Defaults to the site's home with #person, the same on every page. */
  id?: string;
}

/** A picture for link previews, 1200 by 630 for most sites. An imported image works as is. */
export type SeoImage = string | { src: string; alt?: string; width?: number; height?: number };

interface Props {
  /** The whole title, as the tab and the search result show it. */
  title: string;
  /** One or two sentences, ideally under 160 characters. */
  description?: string;
  /** Defaults to this page's address on `site`. */
  canonical?: string | URL;
  image?: SeoImage;
  /** Read aloud and shown when the image does not load. */
  imageAlt?: string;
  /** Defaults to "article" with a citation, else "website". */
  type?: "website" | "article" | "profile";
  siteName?: string;
  /** Such as "en_US". Its language is the citation_language of a paper. */
  locale?: string;
  /** The image's media type, such as "image/png", written as og:image:type. */
  imageType?: string;
  /** The favicon set. `svg` and `png` are addresses; `pngSize` is the raster's size ("192x192"); `apple` is the home-screen icon. */
  icons?: { svg?: string; png?: string; pngSize?: string; apple?: string };
  /** The ground the browser's bar takes in each theme, as hex colors. false leaves the meta out. */
  themeColor?: { light: string; dark: string } | false;
  /** The site's account, such as "@yourname", for X and Twitter cards. */
  twitter?: string;
  /** Keep this page out of search results, such as a 404 or a draft. */
  noindex?: boolean;
  published?: string | Date;
  modified?: string | Date;
  citation?: Citation;
  person?: Person;
  /** The trail from the home page to this one, last item this page. */
  breadcrumbs?: { name: string; href: string }[];
  /** Further schema.org records, written out as they are given. One with the @id of a record
   *  written here is merged into it, and its fields win. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** The sitemap's address, as @astrojs/sitemap writes it: "/sitemap-index.xml" under your base. */
  sitemap?: string;
}

const { title, description, canonical, image, imageAlt, imageType, icons, themeColor = { light: "#FFFFFF", dark: "#161615" }, citation, person, breadcrumbs, schema, sitemap, siteName, locale, twitter, published, modified, noindex = false } = Astro.props;
const type = Astro.props.type ?? (citation ? "article" : "website");
const site = Astro.site;
const here = site ? new URL(Astro.url.pathname, site) : undefined;
// The site's home, with the slash a page address has whether or not base ends in one.
const home = site ? new URL((import.meta.env.BASE_URL || "/").replace(/\/?$/, "/"), site).href : undefined;
if (!site && import.meta.env.DEV) console.warn("[polytope] Seo: set `site` in astro.config so canonical and preview addresses are absolute.");

// Addresses resolve the way an href on this page would.
const abs = (href: string | URL) => (here ? new URL(href, here).href : String(href));
const url = noindex ? undefined : canonical ? abs(canonical) : here?.href;
const pic = typeof image === "string" ? { src: image } : image;
const picAlt = imageAlt ?? (typeof image === "object" ? image.alt : undefined);
const iso = (d: string | Date) => (d instanceof Date ? d.toISOString() : d);
const day = (d: string | Date) => (d instanceof Date ? d.toISOString().slice(0, 10) : d);
const authors = (citation?.authors ?? []).map((a) => (typeof a === "string" ? { name: a, institutions: [] as string[] } : { name: a.name, institutions: a.institutions ?? [] }));
const venue = citation?.journal ?? citation?.conference;
const articleId = citation?.id ? abs(citation.id) : url && `${url.split("#")[0]}#article`;
const personId = person?.id ? abs(person.id) : home && `${home}#person`;
const lang = locale?.replace("_", "-");

// One record per script. Text is escaped so a "</script>" inside a title cannot end the tag.
const records: Record<string, unknown>[] = [];
const ld = (node: Record<string, unknown>) => ({ "@context": "https://schema.org", ...node });
if (person) {
  records.push(ld({
    "@type": "Person", "@id": personId, name: person.name, url: person.url ? abs(person.url) : url, jobTitle: person.jobTitle,
    affiliation: person.affiliation && { "@type": "Organization", name: person.affiliation },
    sameAs: person.sameAs?.length ? person.sameAs : undefined, image: person.image && abs(person.image),
  }));
}
if (citation) {
  const same = [citation.doi && `https://doi.org/${citation.doi}`, citation.arxiv && `https://arxiv.org/abs/${citation.arxiv}`].filter(Boolean);
  records.push(ld({
    "@type": "ScholarlyArticle", "@id": articleId, headline: citation.title, name: citation.title,
    author: (citation.authors ?? []).map((a) => (typeof a === "string" ? { "@type": "Person", name: a } : { "@type": "Person", name: a.name, url: a.href && abs(a.href), affiliation: a.institutions?.length ? a.institutions.map((name) => ({ "@type": "Organization", name })) : undefined })),
    datePublished: day(citation.date), abstract: citation.abstract, keywords: citation.keywords?.length ? citation.keywords.join(", ") : undefined, url, mainEntityOfPage: url, inLanguage: lang,
    isPartOf: venue && { "@type": citation.journal ? "Periodical" : "CreativeWork", name: venue },
    pageStart: citation.firstPage, pageEnd: citation.lastPage,
    image: pic && abs(pic.src),
    encoding: citation.pdf && { "@type": "MediaObject", contentUrl: abs(citation.pdf), encodingFormat: "application/pdf" },
    sameAs: same.length ? same : undefined,
  }));
}
// The home page names the site, as search results show it.
if (siteName && home && url?.replace(/\/$/, "") === home.replace(/\/$/, "")) {
  records.push(ld({ "@type": "WebSite", "@id": `${home}#website`, name: siteName, url: home, inLanguage: lang }));
}
if (breadcrumbs?.length) {
  records.push(ld({
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((b, i) => ({ "@type": "ListItem", position: i + 1, name: b.name, item: abs(b.href) })),
  }));
}
for (const node of [schema ?? []].flat()) records.push("@context" in node ? { ...node } : ld(node));
// Records that share an @id are one thing, and consumers merge them field by field, so two
// author lists for one paper would read as every author twice. They are written as one: the
// first in place, with each later record's fields over it, and a field a later one leaves
// out kept.
const written: Record<string, unknown>[] = [];
const byId = new Map<unknown, Record<string, unknown>>();
for (const node of records) {
  const id = node["@id"];
  const first = id === undefined ? undefined : byId.get(id);
  // Records in another vocabulary are left apart: the same @id would not mean the same thing.
  if (!first || (node["@context"] !== undefined && node["@context"] !== first["@context"])) { if (id !== undefined && !first) byId.set(id, node); written.push(node); continue; }
  for (const [k, v] of Object.entries(node)) if (k !== "@context" && v !== undefined) first[k] = v;
}
const json = (node: unknown) => JSON.stringify(node).replace(/</g, "\\u003c");
---
<title>{title}</title>
{description && <meta name="description" content={description} />}
{url && <link rel="canonical" href={url} />}
{noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="max-image-preview:large" />}
{sitemap && <link rel="sitemap" type="application/xml" href={sitemap} />}

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
{url && <meta property="og:url" content={url} />}
{siteName && <meta property="og:site_name" content={siteName} />}
{locale && <meta property="og:locale" content={locale} />}
{pic && <meta property="og:image" content={abs(pic.src)} />}
{pic && imageType && <meta property="og:image:type" content={imageType} />}
{pic?.width && <meta property="og:image:width" content={String(pic.width)} />}
{pic?.height && <meta property="og:image:height" content={String(pic.height)} />}
{pic && picAlt && <meta property="og:image:alt" content={picAlt} />}
{type === "article" && published && <meta property="article:published_time" content={iso(published)} />}
{type === "article" && modified && <meta property="article:modified_time" content={iso(modified)} />}
<meta name="twitter:card" content={pic ? "summary_large_image" : "summary"} />
{twitter && <meta name="twitter:site" content={twitter} />}
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{pic && <meta name="twitter:image" content={abs(pic.src)} />}
{pic && picAlt && <meta name="twitter:image:alt" content={picAlt} />}
{icons?.svg && <link rel="icon" href={icons.svg} type="image/svg+xml" />}
{icons?.png && <link rel="icon" href={icons.png} type="image/png" sizes={icons.pngSize ?? "192x192"} />}
{icons?.apple && <link rel="apple-touch-icon" href={icons.apple} />}
{themeColor && <meta name="theme-color" content={themeColor.light} media="(prefers-color-scheme: light)" data-ply-bar="light" />}
{themeColor && <meta name="theme-color" content={themeColor.dark} media="(prefers-color-scheme: dark)" data-ply-bar="dark" />}

{citation && (
  <>
    <meta name="citation_title" content={citation.title} />
    {authors.map((a) => (
      <>
        <meta name="citation_author" content={a.name} />
        {a.institutions.map((i) => <meta name="citation_author_institution" content={i} />)}
      </>
    ))}
    <meta name="citation_publication_date" content={day(citation.date).replace(/-/g, "/")} />
    {citation.journal && <meta name="citation_journal_title" content={citation.journal} />}
    {citation.conference && <meta name="citation_conference_title" content={citation.conference} />}
    {citation.volume !== undefined && <meta name="citation_volume" content={String(citation.volume)} />}
    {citation.issue !== undefined && <meta name="citation_issue" content={String(citation.issue)} />}
    {citation.firstPage !== undefined && <meta name="citation_firstpage" content={String(citation.firstPage)} />}
    {citation.lastPage !== undefined && <meta name="citation_lastpage" content={String(citation.lastPage)} />}
    {citation.pdf && <meta name="citation_pdf_url" content={abs(citation.pdf)} />}
    {citation.doi && <meta name="citation_doi" content={citation.doi} />}
    {citation.arxiv && <meta name="citation_arxiv_id" content={citation.arxiv} />}
    {url && <meta name="citation_abstract_html_url" content={url} />}
    {url && <meta name="citation_fulltext_html_url" content={url} />}
    {citation.keywords && citation.keywords.length > 0 && <meta name="citation_keywords" content={citation.keywords.join("; ")} />}
    {lang && <meta name="citation_language" content={lang.split("-")[0]} />}
  </>
)}

{written.map((r) => <script type="application/ld+json" set:html={json(r)} />)}
