---
// A globe of the places in a CV, beside the entries that happened there. As the reader
// scrolls, the globe turns to each entry's place and a tomato ball travels the route to it.
//   <Atlas label="Where I studied and worked">
//     <AtlasStop title="PhD in Computer Science" place="Edinburgh, United Kingdom" ... />
//   </Atlas>
// A "head" slot sits above the entries, beside the globe from the first screen: a page title
// and lede, for a CV page that opens on the globe.
// The server draws the globe with every place, so it is complete without JavaScript;
// css/js/atlas.js makes it turn, zoom, and follow the reading. Outlines: Natural Earth, with
// borders as the United States recognizes them.
import { decode, chart, visited, overview, projection, shows, tally, graticule, sphere, geoPath } from "../dist/js/atlas-core.js";
import world from "../dist/js/atlas-world-110m.js";
interface Props {
  /** Names the map for assistive technology. */
  label?: string;
  /** Offers a filter by kind when the entries have more than one kind. */
  filter?: boolean;
  id?: string;
  class?: string;
}
const { label = "Places", filter = true, id, class: className } = Astro.props;

// The entries render first; their data attributes give the places for the server's globe.
const html = await Astro.slots.render("default");
const unescape = (s: string) => s.replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&amp;/g, "&");
const attr = (tag: string, name: string) => { const m = tag.match(new RegExp(`\\sdata-${name}="([^"]*)"`)); return m ? unescape(m[1]) : undefined; };
const stops = [...html.matchAll(/<li\b[^>]*\bclass="ply-atlas__stop"[^>]*>/g)].map(([tag]) => ({
  place: attr(tag, "place") ?? "", lon: parseFloat(attr(tag, "lon") ?? ""), lat: parseFloat(attr(tag, "lat") ?? ""), from: attr(tag, "from"),
}));

const S = 1000;
const W = decode(world);
const { places, route, moves } = chart(stops);
const view = overview(places, S, S);
const proj = projection(S, S, view);
const path = geoPath(proj).digits(0);
const d = {
  sea: path(sphere), grid: path(graticule), land: path(W.land),
  visited: visited(W.countries, places).map((g) => path(g)).join(""), route: path(route),
};
const seen = places.filter((p) => shows(proj, view, [p.lon, p.lat], S, S)).map((p) => ({ p, xy: proj([p.lon, p.lat])! }));
const names = places.map((p) => p.name).join("; ");
// Names beside the server's points, about 7px a character and 20px a line. Placed first for
// a phone-sized panel (340px across), then again for a wide one (720px), keeping the first
// set where it is; names that fit only the wide panel show only there.
type Label = { name: string; x: number; y: number; side: "right" | "left"; wide?: boolean };
function place(size: number, fixed: Label[]) {
  const k = size / S;
  const boxes = seen.map(({ xy: [x, y] }) => [x * k - 7, y * k - 7, x * k + 7, y * k + 7]);
  const box = (p: { name: string }, x: number, y: number, side: string) => {
    const w = p.name.length * 7 + 14, X = x * k, Y = y * k;
    return side === "right" ? [X + 10, Y - 10, X + 10 + w, Y + 10] : [X - 10 - w, Y - 10, X - 10, Y + 10];
  };
  for (const l of fixed) boxes.push(box(l, l.x * S, l.y * S, l.side));
  const free = (b: number[]) => b[0] >= 0 && b[2] <= size && !boxes.some((o) => b[0] < o[2] && b[2] > o[0] && b[1] < o[3] && b[3] > o[1]);
  return seen.flatMap(({ p, xy: [x, y] }): Label[] => {
    if (fixed.some((l) => l.name === p.name)) return [];
    const side = free(box(p, x, y, "right")) ? "right" : free(box(p, x, y, "left")) ? "left" : null;
    if (!side) return [];
    boxes.push(box(p, x, y, side));
    return [{ name: p.name, x: x / S, y: y / S, side }];
  });
}
const narrow = place(340, []);
const labels = [...narrow, ...place(720, narrow).map((l) => ({ ...l, wide: true }))];
---
<ply-atlas class:list={["ply-atlas", className]} id={id} label={label}>
  <div class="ply-atlas__frame">
    {Astro.slots.has("head") && <div class="ply-atlas__head"><slot name="head" /></div>}
    <div class="ply-atlas__stage">
      <div class="ply-atlas__map" data-surface="panel" role="img" aria-label={`${label}: a globe of ${places.length} ${places.length === 1 ? "place" : "places"}${names ? `, ${names}` : ""}.`}>
        <svg class="ply-atlas__static" viewBox={`0 0 ${S} ${S}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <path data-layer="sea" d={d.sea} />
          <path data-layer="grid" d={d.grid} />
          <path data-layer="land" d={d.land} />
          {d.visited && <path data-layer="visited" d={d.visited} />}
          {d.route && <path data-layer="route" d={d.route} />}
          {seen.map(({ xy: [x, y] }) => <circle cx={Math.round(x)} cy={Math.round(y)} r="7" />)}
        </svg>
        <div class="ply-atlas__static-names" aria-hidden="true">
          {labels.map((l) => <span class="ply-atlas__name" data-side={l.side} data-wide={l.wide ? "" : undefined} style={`--x: ${l.x.toFixed(4)}; --y: ${l.y.toFixed(4)}`}>{l.name}</span>)}
        </div>
      </div>
      <p class="ply-atlas__caption"><b>{label}.</b> <span class="ply-atlas__tally">{tally(places.length, moves)}</span></p>
    </div>
    <div class="ply-atlas__list">
      {filter && <div class="ply-segmented ply-atlas__filter" role="group" aria-label="Show entries" hidden></div>}
      <ol class="ply-atlas__stops"><Fragment set:html={html} /></ol>
    </div>
  </div>
</ply-atlas>
<script>import "../dist/js/atlas.js";</script>
