---
// Light/dark toggle. The choice is kept in localStorage ("ply-theme", no identifier) so the
// next page opens in it; persist={false} keeps it for this page only.
import Icon from "./Icon.astro";
interface Props { persist?: boolean }
const { persist = true } = Astro.props;
---
<button class="ply-button ply-button--ghost ply-button--icon ply-button--sm ply-theme-toggle" type="button" data-ply-theme-toggle data-ply-persist={persist ? undefined : "false"} aria-label="Dark theme" aria-pressed="false">
  <span class="ply-theme-toggle__light"><Icon name="moon" /></span>
  <span class="ply-theme-toggle__dark"><Icon name="sun" /></span>
</button>
<style is:global>
  .ply-theme-toggle__dark { display: none; }
  :root[data-theme="dark"] .ply-theme-toggle__light { display: none; }
  :root[data-theme="dark"] .ply-theme-toggle__dark { display: inline; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .ply-theme-toggle__light { display: none; }
    :root:not([data-theme="light"]) .ply-theme-toggle__dark { display: inline; }
  }
</style>
<script>import "../dist/js/theme.js";</script>
