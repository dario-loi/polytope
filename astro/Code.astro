---
// Highlighted code in a black panel, with an optional copy button.
// Uses Astro's built-in Shiki with the system's code theme.
import { Code as Shiki } from "astro:components";
import theme from "../dist/code-theme.json";
interface Props { code: string; lang?: string; title?: string; copy?: boolean; class?: string }
const { code, lang = "txt", title, copy = true, class: className } = Astro.props;
const first = code.trim().split("\n")[0].trim();
const copyName = `Copy ${title ?? lang} code: ${first.length > 48 ? `${first.slice(0, 45)}...` : first}`;
---
<div class:list={["ply-code", className]}>
  <div class="ply-code__bar">
    <span class="ply-code__lang">{title ?? lang}</span>
    {copy && <button class="ply-code__copy" type="button" data-ply-copy aria-label={copyName}>Copy</button>}
  </div>
  <Shiki code={code.replace(/^\n+|\s+$/g, "")} lang={lang as any} theme={theme as any} />
</div>
<script>import "../dist/js/copy.js";</script>
