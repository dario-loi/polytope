---
// A numbered note that sits in the right margin on wide screens and under the line on narrow ones.
// Usage: <p>Text<Sidenote n={1}>The note.</Sidenote> continues.</p>
interface Props { n: number | string }
const { n } = Astro.props;
---
<sup class="ply-sidenote-ref" id={`sn-ref-${n}`} data-pagefind-ignore>{n}</sup><small class="ply-sidenote" data-n={n} role="note"><slot /></small>
