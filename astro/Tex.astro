---
// Text from data with inline math: each $...$ renders through KaTeX at build time, as <M> does,
// *italic*, **bold**, and ***both*** become <em> and <strong> as in Markdown (a marker may not
// span a formula), and the rest is written out as it is. For a summary, an abstract, or a
// caption kept in front matter or JSON, where <M> in markup has no place.
//   <Tex text={paper.tldr} />          <p><Tex text="Sums over $n \times d$ cells, in *one* pass." /></p>
// `html` passes trusted inline HTML (a figure caption) through; otherwise the text is escaped.
// Each formula stays on one line, since a short formula split after its operator reads wrong.
// This component does not load KaTeX's stylesheet, which would make every page that might show
// math wait for it: put <KatexAssets /> in the head of a page whose text has math (hasMath).
import katex from "katex";
import { MATH, emphasis } from "./tex.ts";
interface Props { text: string; html?: boolean }
const { text, html = false } = Astro.props;

const escape = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const prose = (s: string) => emphasis((html ? s : escape(s)).replace(/\\\$/g, "$"));
let out = "";
let last = 0;
for (const m of text.matchAll(MATH)) {
  const tex = m[1];
  // A double-quoted YAML string turns \t, \b, \n... into control characters (\times becomes a
  // tab and "imes"). Catch that here instead of rendering wrong math.
  if (/[\u0000-\u0008\u000b-\u001f]|\t/.test(tex)) {
    throw new Error(`Math contains a control character: ${JSON.stringify(tex)}. Put the field in single quotes in the front matter.`);
  }
  out += prose(text.slice(last, m.index));
  out += `<span class="ply-math ply-math--line">${katex.renderToString(tex, { displayMode: false, throwOnError: false, output: "htmlAndMathml" })}</span>`;
  last = m.index + m[0].length;
}
out += prose(text.slice(last));
---
<Fragment set:html={out} />
