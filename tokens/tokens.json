{
  "$description": "Polytope tokens. Primitives hold raw values; semantic tokens point at primitives and change per theme. Edit here, then run `npm run build`.",
  "primitive": {
    "color": {
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "ink": {
        "50": { "$type": "color", "$value": "#F6F7F6" },
        "100": { "$type": "color", "$value": "#EEF0EF", "$description": "Gallery wall. Sunken surfaces and table stripes." },
        "200": { "$type": "color", "$value": "#D9DAD6" },
        "300": { "$type": "color", "$value": "#B9BAB4" },
        "400": { "$type": "color", "$value": "#8F8F89" },
        "500": { "$type": "color", "$value": "#6B6B66" },
        "600": { "$type": "color", "$value": "#4A4A47" },
        "700": { "$type": "color", "$value": "#3A3A37" },
        "800": { "$type": "color", "$value": "#262624" },
        "900": { "$type": "color", "$value": "#1C1C1A" },
        "950": { "$type": "color", "$value": "#141414", "$description": "Exhibit black. Panels, heavy rules, body text." }
      },
      "tomato": {
        "100": { "$type": "color", "$value": "#FBE3DE" },
        "400": { "$type": "color", "$value": "#F0654F" },
        "500": { "$type": "color", "$value": "#D9412B", "$description": "The moving part: current location, the balls in the probability machine." },
        "600": { "$type": "color", "$value": "#B8321F" }
      },
      "mustard": {
        "100": { "$type": "color", "$value": "#FBEFD2" },
        "400": { "$type": "color", "$value": "#F2B83A" },
        "500": { "$type": "color", "$value": "#E9A81C", "$description": "Notes and highlights. Always carries black text." },
        "700": { "$type": "color", "$value": "#7A5300" }
      },
      "teal": {
        "100": { "$type": "color", "$value": "#DDF1F0" },
        "300": { "$type": "color", "$value": "#5CC2C7" },
        "700": { "$type": "color", "$value": "#0F6E73", "$description": "Links on light grounds." }
      },
      "cobalt": {
        "100": { "$type": "color", "$value": "#E3EAF8" },
        "200": { "$type": "color", "$value": "#C2D1F0" },
        "300": { "$type": "color", "$value": "#95AEE3" },
        "400": { "$type": "color", "$value": "#6A8BD4" },
        "500": { "$type": "color", "$value": "#3A62C4" },
        "600": { "$type": "color", "$value": "#2B4A99" },
        "700": { "$type": "color", "$value": "#1D336B" }
      }
    }
  },
  "theme": {
    "light": {
      "color": {
        "bg": { "$type": "color", "$value": "{primitive.color.white}", "$description": "Page ground." },
        "surface-sunken": { "$type": "color", "$value": "{primitive.color.ink.100}", "$description": "Recessed areas: table stripes, inline code, input wells." },
        "panel": { "$type": "color", "$value": "{primitive.color.ink.950}", "$description": "Exhibit panel. Code blocks, the probability machine, demo canvases." },
        "panel-text": { "$type": "color", "$value": "{primitive.color.ink.50}" },
        "panel-muted": { "$type": "color", "$value": "{primitive.color.ink.300}" },
        "panel-rule": { "$type": "color", "$value": "{primitive.color.ink.600}" },
        "text": { "$type": "color", "$value": "{primitive.color.ink.950}", "$description": "Body text and headings." },
        "text-muted": { "$type": "color", "$value": "{primitive.color.ink.600}", "$description": "Captions, metadata, secondary navigation." },
        "text-subtle": { "$type": "color", "$value": "{primitive.color.ink.500}", "$description": "Placeholders and the quietest labels. Still above 4.5:1 on the page ground." },
        "rule-strong": { "$type": "color", "$value": "{primitive.color.ink.950}", "$description": "The 3px exhibit rules and control borders." },
        "rule": { "$type": "color", "$value": "{primitive.color.ink.200}", "$description": "Hairlines between rows and list items." },
        "accent": { "$type": "color", "$value": "{primitive.color.tomato.500}", "$description": "Fills only: the current-location point, balls, active marks." },
        "accent-text": { "$type": "color", "$value": "{primitive.color.tomato.600}", "$description": "Tomato when it has to be read as text." },
        "link": { "$type": "color", "$value": "{primitive.color.teal.700}" },
        "link-hover": { "$type": "color", "$value": "{primitive.color.ink.950}" },
        "note": { "$type": "color", "$value": "{primitive.color.mustard.500}", "$description": "Note and highlight fill. Pair with `text`." },
        "note-soft": { "$type": "color", "$value": "{primitive.color.mustard.100}" },
        "focus": { "$type": "color", "$value": "{primitive.color.teal.700}", "$description": "Focus ring on the page ground." },
        "focus-on-panel": { "$type": "color", "$value": "{primitive.color.mustard.400}", "$description": "Focus ring inside black panels." },
        "selection": { "$type": "color", "$value": "{primitive.color.mustard.500}" },
        "code-comment": { "$type": "color", "$value": "{primitive.color.mustard.400}" },
        "code-keyword": { "$type": "color", "$value": "{primitive.color.tomato.400}" },
        "code-string": { "$type": "color", "$value": "{primitive.color.teal.300}" },
        "code-number": { "$type": "color", "$value": "{primitive.color.cobalt.300}" }
      }
    },
    "dark": {
      "color": {
        "bg": { "$type": "color", "$value": "#161615", "$description": "The exhibition after hours." },
        "surface-sunken": { "$type": "color", "$value": "{primitive.color.ink.900}" },
        "panel": { "$type": "color", "$value": "{primitive.color.ink.800}", "$description": "Panels sit lighter than the ground in dark mode." },
        "panel-text": { "$type": "color", "$value": "{primitive.color.ink.50}" },
        "panel-muted": { "$type": "color", "$value": "{primitive.color.ink.300}" },
        "panel-rule": { "$type": "color", "$value": "{primitive.color.ink.600}" },
        "text": { "$type": "color", "$value": "#F2F2EE" },
        "text-muted": { "$type": "color", "$value": "{primitive.color.ink.300}" },
        "text-subtle": { "$type": "color", "$value": "{primitive.color.ink.400}" },
        "rule-strong": { "$type": "color", "$value": "#F2F2EE" },
        "rule": { "$type": "color", "$value": "{primitive.color.ink.700}" },
        "accent": { "$type": "color", "$value": "{primitive.color.tomato.400}" },
        "accent-text": { "$type": "color", "$value": "{primitive.color.tomato.400}" },
        "link": { "$type": "color", "$value": "{primitive.color.teal.300}" },
        "link-hover": { "$type": "color", "$value": "#F2F2EE" },
        "note": { "$type": "color", "$value": "{primitive.color.mustard.500}" },
        "note-soft": { "$type": "color", "$value": "#3A2F14" },
        "focus": { "$type": "color", "$value": "{primitive.color.mustard.400}" },
        "focus-on-panel": { "$type": "color", "$value": "{primitive.color.mustard.400}" },
        "selection": { "$type": "color", "$value": "{primitive.color.mustard.500}" },
        "code-comment": { "$type": "color", "$value": "{primitive.color.mustard.400}" },
        "code-keyword": { "$type": "color", "$value": "{primitive.color.tomato.400}" },
        "code-string": { "$type": "color", "$value": "{primitive.color.teal.300}" },
        "code-number": { "$type": "color", "$value": "{primitive.color.cobalt.300}" }
      }
    }
  },
  "viz": {
    "$description": "Chart colors. Categorical slots are assigned in this order and never cycled. Validated for color vision deficiency with the dataviz palette checks (adjacent pairs). Scatter plots and small multiples use the first three slots only.",
    "categorical": {
      "light": ["#D9412B", "#009B93", "#3A62C4", "#4C8C2B", "#2E8FD0", "#C28A0A", "#9A3E96", "#E06C91"],
      "dark": ["#E04B34", "#00A39A", "#5A7FDB", "#5A9A35", "#2E8FD0", "#B98200", "#9A52C8", "#D9658B"],
      "names": ["tomato", "teal", "cobalt", "grass", "sky", "mustard", "plum", "pink"]
    },
    "sequential": ["#E3EAF8", "#C2D1F0", "#95AEE3", "#6A8BD4", "#3A62C4", "#2B4A99", "#1D336B"],
    "diverging": ["#2B4A99", "#6A8BD4", "#C2D1F0", "#D9DAD6", "#F6C3B9", "#E8765F", "#B8321F"],
    "status": { "good": "#1E7A3C", "warning": "#F2B71F", "serious": "#E8743B", "critical": "#B3261E" },
    "surface": { "light": "#FFFFFF", "dark": "#1C1C1A" }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": "\"Ultra\", \"Rockwell Extra Bold\", Rockwell, Georgia, serif", "$description": "Wood-type slab for titles, the wordmark, and big numerals. Never for running text." },
      "text": { "$type": "fontFamily", "$value": "\"Libre Franklin Variable\", \"Libre Franklin\", \"Franklin Gothic Medium\", \"Helvetica Neue\", Arial, sans-serif", "$description": "Everything that gets read: body, UI, captions, tables." },
      "mono": { "$type": "fontFamily", "$value": "\"JetBrains Mono Variable\", \"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace", "$description": "Code, keyboard keys, and numeric parameters." }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "0.8125rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "md": { "$type": "dimension", "$value": "1rem" },
      "body": { "$type": "dimension", "$value": "1.0625rem", "$description": "17px reading size." },
      "lg": { "$type": "dimension", "$value": "1.25rem" },
      "xl": { "$type": "dimension", "$value": "1.5rem" },
      "2xl": { "$type": "dimension", "$value": "2rem" },
      "3xl": { "$type": "dimension", "$value": "2.75rem" },
      "4xl": { "$type": "dimension", "$value": "4rem" },
      "display": { "$type": "dimension", "$value": "clamp(3rem, 1.6rem + 4.4vw, 5.75rem)", "$description": "Page titles. 48px on phones up to 92px on wide screens." }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "leading": {
      "display": { "$type": "number", "$value": 0.98 },
      "tight": { "$type": "number", "$value": 1.2 },
      "normal": { "$type": "number", "$value": 1.45 },
      "relaxed": { "$type": "number", "$value": 1.6 }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0" },
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.5rem" },
    "6": { "$type": "dimension", "$value": "2rem" },
    "7": { "$type": "dimension", "$value": "3rem" },
    "8": { "$type": "dimension", "$value": "4rem" },
    "9": { "$type": "dimension", "$value": "6rem" },
    "10": { "$type": "dimension", "$value": "8rem" }
  },
  "border": {
    "hair": { "$type": "dimension", "$value": "1px" },
    "control": { "$type": "dimension", "$value": "2px" },
    "rule": { "$type": "dimension", "$value": "3px", "$description": "The exhibit rule under the top bar and between page regions." }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0", "$description": "Panels, buttons, inputs, and code blocks are square." },
    "ball": { "$type": "dimension", "$value": "999px", "$description": "Only round things are round: balls, points, status dots." }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "200ms" },
      "slow": { "$type": "duration", "$value": "320ms" },
      "drop": { "$type": "duration", "$value": "900ms", "$description": "One ball falling through the machine." }
    },
    "ease": {
      "out": { "$type": "cubicBezier", "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$description": "Default for UI that arrives." },
      "gravity": { "$type": "cubicBezier", "$value": "cubic-bezier(0.55, 0, 1, 0.45)", "$description": "Things that fall." }
    }
  },
  "layout": {
    "measure": { "$type": "dimension", "$value": "36rem", "$description": "Reading column: about 68 characters of body text at 17px. Set in rem so notes, code, and text in one column share an edge." },
    "gutter": { "$type": "dimension", "$value": "clamp(1rem, 0.2rem + 4vw, 4.5rem)", "$description": "Page side margin: 16px on phones, 72px on wide screens." },
    "sidebar": { "$type": "dimension", "$value": "17.5rem" },
    "toc": { "$type": "dimension", "$value": "15rem" },
    "max": { "$type": "dimension", "$value": "90rem" }
  }
}
